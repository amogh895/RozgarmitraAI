# .streamlit/secrets.toml.example
# ---------------------------------
# Copy this file to .streamlit/secrets.toml and fill in your values for LOCAL development.
# For Streamlit Community Cloud: paste these keys into the app's Secrets dashboard
# (App settings → Secrets) — do NOT upload secrets.toml to GitHub.

WATSONX_API_KEY = "your_ibm_cloud_api_key_here"
WATSONX_PROJECT_ID = "your_watsonx_project_id_here"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
