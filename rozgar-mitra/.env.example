# ─── KaushalMitra AI – Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret for production: openssl rand -hex 64
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use default path: backend/data/kaushal_mitra.db
DB_PATH=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── IBM watsonx.ai (IBM Granite AI Mentor) ────────────────────────────────────
# Required for live AI mentor features.
# Lite plan: 300,000 free inference tokens/month, 2 req/s rate limit.
#
# How to obtain:
#   1. Create IBM Cloud account at https://cloud.ibm.com
#   2. Create a watsonx.ai Runtime instance (Lite plan is free)
#   3. Create a watsonx.ai Studio project and note the Project ID
#   4. Create an IBM Cloud API key at https://cloud.ibm.com/iam/apikeys
#
# Without these values the app starts normally but AI mentor shows
# "AI mentor is currently unavailable" — all other features work.

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_SERVICE_URL=https://us-south.ml.cloud.ibm.com
# Currently supported multitenant Granite model (Lite-compatible, April 2025):
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ── Security (production only) ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
